# Supabase (Project Settings -> API Keys)
SUPABASE_URL=
# Publishable key (sb_publishable_...): RLS-restricted, used for all public reads.
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPTILER_KEY=

# Never commit these values or return them from an API endpoint.
# Secret key (sb_secret_...): bypasses RLS. Server-side ingestion only.
SUPABASE_SECRET_KEY=
# Ticketmaster Discovery (https://developer.ticketmaster.com, "Consumer Key"). Enables live
# events on the dashboard and in Local Pulse; without it Local Pulse scores conditions only.
TICKETMASTER_API_KEY=
EVENTBRITE_TOKEN=
UDOT_API_KEY=
NPS_API_KEY=
# Recreation.gov RIDB (free, https://ridb.recreation.gov/profile). Enables the `ridb` places
# ingest (campgrounds and recreation facilities); without it that source is skipped.
RIDB_API_KEY=
# Google Places API (New): enable billing and the Places API. Every call is billed and the
# results must not be stored beyond place_id. Not called by any route yet.
GOOGLE_MAPS_API_KEY=
# Header secret for POST /api/admin/ingest (x-ingest-secret).
INGEST_SECRET=
# Vercel Cron bearer secret for GET /api/cron/ingest and /api/cron/ingest-places (scheduled in vercel.json).
CRON_SECRET=
# Identifies every upstream request (NWS, Utah DAQ, ArcGIS, Overpass, RIDB). Name the app and a
# monitored contact: Overpass rejects generic or placeholder agents with HTTP 406.
NWS_USER_AGENT=ComprehensiveUtah/0.1 contact@example.com

# Outdoor Comfort model: a JSON artifact written by scripts/train_outdoor_comfort.py.
# Without one (or with this set to false) the API serves the labelled rules fallback.
OUTDOOR_COMFORT_MODEL_PATH=backend/intelligence/artifacts/outdoor_comfort.json
INTELLIGENCE_ENABLE_TRAINED_MODEL=true
