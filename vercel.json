{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/map",
      "destination": "/map.html"
    },
    {
      "source": "/inversion",
      "destination": "/inversion.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ingest",
      "schedule": "17 10 * * *"
    },
    {
      "path": "/api/cron/ingest-places",
      "schedule": "43 10 * * 1"
    }
  ]
}
