{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/map-simple.html" },
    { "source": "/map/simple", "destination": "/map-simple.html" },
    { "source": "/map", "destination": "/map.html" },
    { "source": "/inversion", "destination": "/inversion.html" },
    { "source": "/promoters", "destination": "/promoters.html" }
  ],
  "crons": [
    { "path": "/api/cron/ingest", "schedule": "17 10 * * *" },
    { "path": "/api/cron/ingest-live", "schedule": "32 10 * * *" },
    { "path": "/api/cron/refresh-guide", "schedule": "52 10 * * *" },
    { "path": "/api/cron/ingest-places", "schedule": "43 10 * * 1" }
  ]
}
